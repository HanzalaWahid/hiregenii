# HireGenii backend configuration.
# Copy to .env (repository root) or backend/.env. Both are gitignored; never commit real values.
# The frontend has its own file: frontend/.env.example (VITE_API_BASE_URL).

# --- App ---
# development | production. In production the API refuses to start without a strong JWT_SECRET.
APP_ENV=development
# Comma-separated list; defaults to the local dev ports when empty.
CORS_ORIGINS=

# --- Auth (interim custom JWT until Supabase Auth) ---
# Random value, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset in development, a random per-process secret is used (logins reset on restart).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# --- Local storage (relative paths are resolved from backend/) ---
DB_PATH=data/app.db
UPLOAD_DIR=uploads
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=5.0

# --- Resume analysis extractor ---
# auto | custom_rule | gemini | cerebras
EXTRACTOR_PROVIDER=auto
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b

# --- LLM providers (explanations / AI features; rule-based fallback when empty) ---
GROQ_API_KEY=
GEMINI_API_KEY=
